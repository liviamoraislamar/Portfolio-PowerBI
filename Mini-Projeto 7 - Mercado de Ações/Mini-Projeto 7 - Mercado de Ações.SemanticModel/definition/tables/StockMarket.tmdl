				  Origem = Excel.Workbook(File.Contents("C:\Users\livia\Documents\Curso de PowerBI\Aulas DataScience Academy\StockMarket\StockMarket.xlsx"), null, true),
				  #"Navegação 1" = Origem{[Item = "StockMarket", Kind = "Sheet"]}[Data],
